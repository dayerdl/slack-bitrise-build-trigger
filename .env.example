SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
BITRISE_API_TOKEN=replace-with-bitrise-personal-access-token
BITRISE_APP_SLUG=replace-with-bitrise-app-slug

# Persisting the release table when the host cannot write local files: set both variables.
# Needed for `release add` / `release delete` and for auto-updating `data/client-releases.tsv`
# after each `/flutter-build` when `ENV[build_version]` is set.
# Token needs write access to repository contents.
GITHUB_TOKEN=
GITHUB_REPOSITORY=dayerdl/slack-bitrise-build-trigger
# Optional: branch and path (defaults shown).
# GITHUB_RELEASE_BRANCH=main
# RELEASE_TSV_PATH=data/client-releases.tsv

# Comma-separated account keys for ENV[platform_account] (match Coniq clients/ folder slugs when possible).
# See data/coniq_client_folders.txt and data/client_slug_to_tsv.json in this repo.
# Map ENV[platform_account] → TSV `client` column: data/build_customer_to_tsv_client.json
ALLOWED_CUSTOMERS=whitelabel,tanger,moa,wolfsburg,village,liwa

# Branch used for quick deploy: `/flutter-build <account> <env>` (default: development).
# DEFAULT_SLACK_DEPLOY_BRANCH=development

# Optional: protect the /api/bitrise-webhook endpoint (Bitrise outgoing webhook headers).
BITRISE_WEBHOOK_SECRET=''

# Set to false to skip appending a release row after Bitrise trigger (default: true).
# RECORD_RELEASE_TSV_ON_BUILD=true

# Optional: fallback Slack webhook/channel notification is handled by Slack response_url.
# The endpoint posts an async success/failure message back to the originating Slack chat.
